{
  "name": "URL to RAG Document Processor",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "url-rag-processor",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.body.url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "name": "Fetch Web Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {},
        "prompt": "=Clean the following raw HTML text and convert it into markdown format suitable for a RAG Vector Database embedding. Extract main article text, remove navigation and scripts.\n\nRAW HTML:\n{{ $json.data.substring(0, 12000) }}"
      },
      "name": "AI Text Cleaner & Markdown Generator",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "RAG_Knowledge_Base",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "URL": "={{ $('Webhook Trigger').item.json.body.url }}",
            "Markdown": "={{ $json.message.content }}",
            "Processed_Date": "={{ new Date().toISOString() }}"
          }
        }
      },
      "name": "Save to Knowledge Base",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        850,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Fetch Web Page",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Web Page": {
      "main": [
        [
          {
            "node": "AI Text Cleaner & Markdown Generator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Text Cleaner & Markdown Generator": {
      "main": [
        [
          {
            "node": "Save to Knowledge Base",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
